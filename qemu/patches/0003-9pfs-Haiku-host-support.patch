new file mode 100644
index 000000000..7af95ad9c
--- /dev/null
+++ b/hw/9pfs/9p-util-haiku.c
@@ -0,0 +1,329 @@
+/*
+ * 9p utilities (Haiku Implementation)
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+/*
+ * Not so fast! You might want to read the 9p developer docs first:
+ * https://wiki.qemu.org/Documentation/9p
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/xattr.h"
+#include "fsdev/file-op-9p.h"
+#include "9p-util.h"
+
+#include <fs_attr.h>
+#include <fs_info.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <TypeConstants.h>
+
+/*
+ * Extended attributes are BFS attributes. A Linux xattr "user.foo" is the
+ * attribute "linux:user.foo", so the guest's attributes never collide with
+ * Haiku's own (BEOS:TYPE and the like), which the guest does not see.
+ */
+#define XATTR_PREFIX "linux:"
+#define XATTR_PREFIX_LEN (sizeof(XATTR_PREFIX) - 1)
+
+static char *attr_name(const char *name)
+{
+    return g_strconcat(XATTR_PREFIX, name, NULL);
+}
+
+static int open_nofollow(int dirfd, const char *filename)
+{
+    /*
+     * No O_PATH: only what opens for reading carries attributes here, so
+     * a symlink, a socket or a FIFO has none.
+     */
+    struct stat st;
+    int fd;
+
+    if (fstatat(dirfd, filename, &st, AT_SYMLINK_NOFOLLOW) == 0 &&
+        !S_ISREG(st.st_mode) && !S_ISDIR(st.st_mode)) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    fd = openat_file(dirfd, filename, O_RDONLY | O_NOFOLLOW, 0);
+    if (fd == -1 && errno == ELOOP) {
+        errno = ENOTSUP;
+    }
+    return fd;
+}
+
+ssize_t fgetxattr(int fd, const char *name, void *value, size_t size)
+{
+    g_autofree char *attr = attr_name(name);
+    attr_info info;
+
+    if (fs_stat_attr(fd, attr, &info) != 0) {
+        if (errno == ENOENT || errno == B_ENTRY_NOT_FOUND || errno == -B_ENTRY_NOT_FOUND) {
+            errno = ENOATTR;
+        } else {
+            errno = ENOTSUP; /* a file system without attributes */
+        }
+        return -1;
+    }
+    if (size == 0) {
+        return info.size;
+    }
+    if ((size_t)info.size > size) {
+        errno = ERANGE;
+        return -1;
+    }
+    return fs_read_attr(fd, attr, B_RAW_TYPE, 0, value, info.size);
+}
+
+ssize_t fgetxattrat_nofollow(int dirfd, const char *filename, const char *name,
+                             void *value, size_t size)
+{
+    ssize_t ret;
+    int fd = open_nofollow(dirfd, filename);
+
+    if (fd == -1) {
+        return -1;
+    }
+    ret = fgetxattr(fd, name, value, size);
+    close_preserve_errno(fd);
+    return ret;
+}
+
+ssize_t flistxattrat_nofollow(int dirfd, const char *filename,
+                              char *list, size_t size)
+{
+    ssize_t total = 0;
+    struct dirent *de;
+    DIR *dir;
+    int fd = open_nofollow(dirfd, filename);
+
+    if (fd == -1) {
+        return -1;
+    }
+    dir = fs_fopen_attr_dir(fd);
+    if (!dir) {
+        /* no attributes on this file system: an empty list */
+        close(fd);
+        return 0;
+    }
+    while ((de = fs_read_attr_dir(dir)) != NULL) {
+        size_t len;
+
+        if (strncmp(de->d_name, XATTR_PREFIX, XATTR_PREFIX_LEN) != 0) {
+            continue;
+        }
+        len = strlen(de->d_name + XATTR_PREFIX_LEN) + 1;
+        if (size != 0) {
+            if (total + len > size) {
+                fs_close_attr_dir(dir);
+                close(fd);
+                errno = ERANGE;
+                return -1;
+            }
+            memcpy(list + total, de->d_name + XATTR_PREFIX_LEN, len);
+        }
+        total += len;
+    }
+    fs_close_attr_dir(dir);
+    close(fd);
+    return total;
+}
+
+ssize_t fremovexattrat_nofollow(int dirfd, const char *filename,
+                                const char *name)
+{
+    g_autofree char *attr = attr_name(name);
+    int ret, fd = open_nofollow(dirfd, filename);
+
+    if (fd == -1) {
+        return -1;
+    }
+    ret = fs_remove_attr(fd, attr);
+    if (ret != 0 && (errno == ENOENT || errno == B_ENTRY_NOT_FOUND)) {
+        errno = ENOATTR;
+    }
+    close_preserve_errno(fd);
+    return ret;
+}
+
+int fsetxattrat_nofollow(int dirfd, const char *filename, const char *name,
+                         void *value, size_t size, int flags)
+{
+    g_autofree char *attr = attr_name(name);
+    attr_info info;
+    ssize_t ret;
+    int fd;
+
+    if (flags == (XATTR_CREATE | XATTR_REPLACE)) {
+        errno = EINVAL;
+        return -1;
+    }
+    fd = open_nofollow(dirfd, filename);
+    if (fd == -1) {
+        return -1;
+    }
+    if (flags & (XATTR_CREATE | XATTR_REPLACE)) {
+        bool exists = fs_stat_attr(fd, attr, &info) == 0;
+
+        if (exists && (flags & XATTR_CREATE)) {
+            close(fd);
+            errno = EEXIST;
+            return -1;
+        }
+        if (!exists && (flags & XATTR_REPLACE)) {
+            close(fd);
+            errno = ENOATTR;
+            return -1;
+        }
+    }
+    /* fs_write_attr() keeps a longer old value's tail: replace it whole */
+    fs_remove_attr(fd, attr);
+    ret = fs_write_attr(fd, attr, B_RAW_TYPE, 0, value, size);
+    close_preserve_errno(fd);
+    return ret < 0 ? -1 : 0;
+}
+
+/*
+ * Haiku's mknodat() makes FIFOs only. A socket node is what binding a Unix
+ * domain socket leaves behind, so bind one under a short temporary name (on
+ * the same volume) and move it into place. Device nodes cannot exist on BFS.
+ */
+static int mksocketat(int dirfd, const char *filename, mode_t mode)
+{
+    struct sockaddr_un addr = { .sun_family = AF_UNIX };
+    g_autofree char *tmpdir = NULL;
+    int sock, ret, serrno;
+
+    tmpdir = g_dir_make_tmp("qemu-9p-XXXXXX", NULL);
+    if (!tmpdir) {
+        errno = EIO;
+        return -1;
+    }
+    if (snprintf(addr.sun_path, sizeof(addr.sun_path), "%s/s", tmpdir) >=
+        sizeof(addr.sun_path)) {
+        rmdir(tmpdir);
+        errno = ENAMETOOLONG;
+        return -1;
+    }
+    sock = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (sock == -1) {
+        serrno = errno;
+        rmdir(tmpdir);
+        errno = serrno;
+        return -1;
+    }
+    ret = bind(sock, (struct sockaddr *)&addr, sizeof(addr));
+    serrno = errno;
+    close(sock);
+    if (ret == 0) {
+        ret = renameat(AT_FDCWD, addr.sun_path, dirfd, filename);
+        serrno = errno;
+        if (ret == 0) {
+            fchmodat(dirfd, filename, mode & 07777, AT_SYMLINK_NOFOLLOW);
+        } else {
+            unlink(addr.sun_path);
+        }
+    }
+    rmdir(tmpdir);
+    errno = serrno;
+    return ret;
+}
+
+int qemu_mknodat(int dirfd, const char *filename, mode_t mode, dev_t dev)
+{
+    if (S_ISSOCK(mode)) {
+        return mksocketat(dirfd, filename, mode);
+    }
+    if (S_ISFIFO(mode)) {
+        return mkfifoat(dirfd, filename, mode & 07777);
+    }
+    if (S_ISREG(mode)) {
+        int fd = openat(dirfd, filename, O_CREAT | O_EXCL | O_WRONLY,
+                        mode & 07777);
+        if (fd == -1) {
+            return -1;
+        }
+        close(fd);
+        return 0;
+    }
+    errno = EPERM;
+    return -1;
+}
+
+int qemu_haiku_fstatfs(int fd, struct statfs *stbuf)
+{
+    struct statvfs vfs;
+    struct stat st;
+
+    if (fstatvfs(fd, &vfs) != 0 || fstat(fd, &st) != 0) {
+        return -1;
+    }
+    memset(stbuf, 0, sizeof(*stbuf));
+    stbuf->f_type = 0x42465331; /* "BFS1", BFS's own magic */
+    stbuf->f_bsize = vfs.f_bsize;
+    stbuf->f_blocks = vfs.f_blocks * vfs.f_frsize / vfs.f_bsize;
+    stbuf->f_bfree = vfs.f_bfree * vfs.f_frsize / vfs.f_bsize;
+    stbuf->f_bavail = vfs.f_bavail * vfs.f_frsize / vfs.f_bsize;
+    stbuf->f_files = vfs.f_files;
+    stbuf->f_ffree = vfs.f_ffree;
+    stbuf->f_fsid.val[0] = st.st_dev;
+    stbuf->f_namelen = vfs.f_namemax;
+    return 0;
+}
+
+int haiku_errno_to_linux(int err)
+{
+    static const struct { int haiku, linux; } map[] = {
+        { EPERM, 1 }, { ENOENT, 2 }, { ESRCH, 3 }, { EINTR, 4 }, { EIO, 5 },
+        { ENXIO, 6 }, { E2BIG, 7 }, { ENOEXEC, 8 }, { EBADF, 9 },
+        { ECHILD, 10 }, { EAGAIN, 11 }, { ENOMEM, 12 }, { EACCES, 13 },
+        { EFAULT, 14 }, { EBUSY, 16 }, { EEXIST, 17 }, { EXDEV, 18 },
+        { ENODEV, 19 }, { ENOTDIR, 20 }, { EISDIR, 21 }, { EINVAL, 22 },
+        { ENFILE, 23 }, { EMFILE, 24 }, { ENOTTY, 25 }, { ETXTBSY, 26 },
+        { EFBIG, 27 }, { ENOSPC, 28 }, { ESPIPE, 29 }, { EROFS, 30 },
+        { EMLINK, 31 }, { EPIPE, 32 }, { EDOM, 33 }, { ERANGE, 34 },
+        { EDEADLK, 35 }, { ENAMETOOLONG, 36 }, { ENOLCK, 37 }, { ENOSYS, 38 },
+        { ENOTEMPTY, 39 }, { ELOOP, 40 }, { ENOMSG, 42 }, { EIDRM, 43 },
+        { ENOSTR, 60 }, { ENODATA, 61 }, { ENOATTR, 61 }, { ETIME, 62 },
+        { ENOLINK, 67 }, { EPROTO, 71 }, { EMULTIHOP, 72 }, { EBADMSG, 74 },
+        { EOVERFLOW, 75 }, { EILSEQ, 84 }, { ENOTSOCK, 88 },
+        { EDESTADDRREQ, 89 }, { EMSGSIZE, 90 }, { EPROTOTYPE, 91 },
+        { ENOPROTOOPT, 92 }, { EPROTONOSUPPORT, 93 }, { ENOTSUP, 95 },
+        { EOPNOTSUPP, 95 }, { EAFNOSUPPORT, 97 }, { EADDRINUSE, 98 },
+        { EADDRNOTAVAIL, 99 }, { ENETDOWN, 100 }, { ENETUNREACH, 101 },
+        { ENETRESET, 102 }, { ECONNABORTED, 103 }, { ECONNRESET, 104 },
+        { ENOBUFS, 105 }, { EISCONN, 106 }, { ENOTCONN, 107 },
+        { ETIMEDOUT, 110 }, { ECONNREFUSED, 111 }, { EHOSTUNREACH, 113 },
+        { EALREADY, 114 }, { EINPROGRESS, 115 }, { ESTALE, 116 },
+        { EDQUOT, 122 }, { ECANCELED, 125 },
+    };
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(map); i++) {
+        if (map[i].haiku == err) {
+            return map[i].linux;
+        }
+    }
+    /* Haiku's own codes, which some calls report as they are */
+    static const struct { status_t haiku; int linux; } bmap[] = {
+        { B_ENTRY_NOT_FOUND, 2 }, { B_NOT_ALLOWED, 1 },
+        { B_PERMISSION_DENIED, 13 }, { B_BAD_VALUE, 22 },
+        { B_NOT_SUPPORTED, 95 }, { B_UNSUPPORTED, 95 }, { B_NO_MEMORY, 12 },
+        { B_FILE_ERROR, 9 }, { B_FILE_EXISTS, 17 }, { B_NAME_IN_USE, 17 },
+        { B_BUSY, 16 }, { B_READ_ONLY_DEVICE, 30 }, { B_NOT_A_DIRECTORY, 20 },
+        { B_IS_A_DIRECTORY, 21 }, { B_DIRECTORY_NOT_EMPTY, 39 },
+        { B_LINK_LIMIT, 40 }, { B_NAME_TOO_LONG, 36 }, { B_DEVICE_FULL, 28 },
+        { B_CROSS_DEVICE_LINK, 18 }, { B_TIMED_OUT, 110 },
+        { B_INTERRUPTED, 4 }, { B_WOULD_BLOCK, 11 }, { B_BAD_TYPE, 22 },
+        { B_BAD_INDEX, 22 }, { B_DEVICE_NOT_FOUND, 19 },
+    };
+    for (i = 0; i < ARRAY_SIZE(bmap); i++) {
+        if (bmap[i].haiku == err || -bmap[i].haiku == err) {
+            return bmap[i].linux;
+        }
+    }
+    return 5; /* EIO */
+}
